{
  "name": "n8n-nodes-ftp-trigger-owen",
  "version": "1.2.0",
  "description": "n8n node for starting workflows when FTP or SFTP events occur.",
  "keywords": [
    "n8n-community-node-package",
    "ftp",
    "sftp",
    "polling"
  ],
  "license": "MIT",
  "homepage": "https://github.com/77owen/n8n-nodes-ftp-trigger",
  "author": {
    "name": "Owen Billings"
  },
  "contributors": [
    {
      "name": "Nicholas Penree",
      "email": "nick@penree.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/77owen/n8n-nodes-ftp-trigger.git"
  },
  "bugs": {
    "url": "https://github.com/77owen/n8n-nodes-ftp-trigger/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/FtpTrigger/FtpTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/picomatch": "^4.0.3",
    "@types/promise-ftp": "^1.3.4",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "ftp-srv": "^4.6.3",
    "gulp": "^4.0.2",
    "n8n-core": "*",
    "n8n-workflow": "*",
    "prettier": "^3.8.3",
    "ssh2": "^1.16.0",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "mime-types": "^2.1.35",
    "picomatch": "^4.0.2",
    "promise-ftp": "^1.3.5",
    "ssh2-sftp-client": "^12.1.1"
  }
}
